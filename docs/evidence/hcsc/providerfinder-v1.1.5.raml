title: Provider Finder
baseUri: api.hcsc.net/providerfinder/
version: v1
protocols:
  - HTTPS
/sapphire/fhir: {}
/sapphire/fhir/Location:
  get:
    (amf-consumes):
      - application/json
    (amf-produces):
      - application/json
    queryParameters:
      name:
        required: false
        type: string
      address-city:
        required: false
        type: string
      address-state:
        required: false
        type: string
      address-postalcode:
        required: false
        type: string
    body: {}
    responses:
      "200":
        description: Location found by name
        body: {}
    (oas-summary): Search a Location by given query params
    (oas-tags):
      - FHIR Location
/sapphire/fhir/Location/{id}:
  get:
    (amf-consumes):
      - application/json
    (amf-produces):
      - application/json
    body: {}
    responses:
      "200":
        description: Location found
        body: {}
      "404":
        description: Location not found
        body: {}
    (oas-summary): Retrieves a Location by id
    (oas-tags):
      - FHIR Location
  uriParameters:
    id:
      type: string
/sapphire/fhir/Organization:
  get:
    (amf-consumes):
      - application/json
    (amf-produces):
      - application/json
    queryParameters:
      name:
        required: false
        type: string
    body: {}
    responses:
      "200":
        description: Organization found by name
        body: {}
    (oas-summary): Search a Organization by given query params
    (oas-tags):
      - FHIR Organization
/sapphire/fhir/Organization/{id}:
  get:
    (amf-consumes):
      - application/json
    (amf-produces):
      - application/json
    body: {}
    responses:
      "200":
        description: Practitioner found
        body: {}
      "404":
        description: Organization not found
        body: {}
    (oas-summary): Retrieves a Organization by id
    (oas-tags):
      - FHIR Organization
  uriParameters:
    id:
      type: string
/sapphire/fhir/OrganizationAffiliation:
  get:
    (amf-consumes):
      - application/json
    (amf-produces):
      - application/json
    queryParameters:
      specialty:
        required: false
        type: string
      network:
        required: false
        type: string
      location:
        required: false
        type: string
      primary-organization:
        required: false
        type: string
    body: {}
    responses:
      "200":
        description: Organization Affiliation by specialty
        body: {}
    (oas-summary): Search OrganizationAffiliation by given query params
    (oas-tags):
      - FHIR OrganizationAffiliation
/sapphire/fhir/OrganizationAffiliation/{id}:
  get:
    (amf-consumes):
      - application/json
    (amf-produces):
      - application/json
    body: {}
    responses:
      "200":
        description: Practitioner found
        body: {}
    (oas-summary): Retrieves a OrganizationAffiliation by id
    (oas-tags):
      - FHIR OrganizationAffiliation
  uriParameters:
    id:
      type: string
/sapphire/fhir/Practitioner:
  get:
    (amf-consumes):
      - application/json
    (amf-produces):
      - application/json
    queryParameters:
      family:
        required: false
        type: string
      given:
        required: false
        type: string
      name:
        required: false
        type: string
    body: {}
    responses:
      "200":
        description: Practitioner found by name
        body: {}
    (oas-summary): Search a Practitioner by given query params
    (oas-tags):
      - FHIR Practitioner
/sapphire/fhir/Practitioner/{id}:
  get:
    (amf-consumes):
      - application/json
    (amf-produces):
      - application/json
    body: {}
    responses:
      "200":
        description: Practitioner found
        body: {}
      "404":
        description: Practitioner not found
        body: {}
    (oas-summary): Retrieves a Practitioner by id
    (oas-tags):
      - FHIR Practitioner
  uriParameters:
    id:
      type: string
/sapphire/fhir/PractitionerRole:
  get:
    (amf-consumes):
      - application/json
    (amf-produces):
      - application/json
    queryParameters:
      practitioner:
        required: false
        type: string
      organization:
        required: false
        type: string
      network:
        required: false
        type: string
      location:
        required: false
        type: string
      specialty:
        required: false
        type: string
    body: {}
    responses:
      "200":
        description: PractitionerRole found by given query params
        body: {}
    (oas-summary): Search a PractitionerRole by given query params
    (oas-tags):
      - FHIR PractitionerRole
/sapphire/fhir/PractitionerRole/{id}:
  get:
    (amf-consumes):
