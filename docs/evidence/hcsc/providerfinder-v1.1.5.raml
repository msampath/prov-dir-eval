    body: {}
    responses:
      "200":
        description: PractitionerRole found
        body: {}
      "404":
        description: PractitionerRole not found
        body: {}
    (oas-summary): Retrieves a PractitionerRole by id
    (oas-tags):
      - FHIR PractitionerRole
  uriParameters:
    id:
      type: string
/hcsc/{resourcePath}:
  post:
    (amf-consumes):
      - application/json
    (amf-produces):
      - application/json
    headers:
      ClientId:
        description: Client ID
        required: true
        type: string
      ClientSecret:
        description: Client Secret
        required: true
        type: string
      Accept:
        required: false
        type: string
      Content-Type:
        description: Body Content Type
        required: false
        type: string
      Authorization:
        description: JWT Token
        required: false
        type: string
    body:
      application/json:
        type: any
    responses:
      "200":
        description: Successful Request
        body:
          application/json:
            example:
              strict: false
              value:
                responseCode: 200
                response: Ok
            type: any
      "201":
        description: Created Request
        body:
          application/json:
            example:
              strict: false
              value:
                responseCode: 201
                response: Created
            type: any
      "400":
        description: Bad Request
        body:
          application/json:
            example:
              strict: false
              value:
                responseCode: 400
                response: Bad Request
            type: any
      "401":
        description: Unauthorized Request
        body:
          application/json:
            example:
              strict: false
              value:
                responseCode: 401
                response: Unauthorized
            type: any
      "403":
        description: Forbidden Request
        body:
          application/json:
            example:
              strict: false
              value:
                responseCode: 403
                response: Forbidden
            type: any
      "404":
        description: Not Found
        body:
          application/json:
            example:
              strict: false
              value:
                responseCode: 404
                response: Not Found
            type: any
      "500":
        description: Internal Server Error
        body:
          application/json:
            example:
              strict: false
              value:
                responseCode: 500
                response: Internal Server Error
            type: any
  uriParameters:
    resourcePath:
      type: string
