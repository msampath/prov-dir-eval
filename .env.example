# ---------------------------------------------------------------------------
# prov-dir-eval environment configuration
# Copy this file to `.env` (which is git-ignored) and fill in values.
# Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Local Postgres (Phases 4-8) ---------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=provdir
POSTGRES_USER=provdir
POSTGRES_PASSWORD=

# --- HTTP client behaviour ---------------------------------------------------
HTTP_TIMEOUT_SECONDS=60
HTTP_MAX_RETRIES=4
# Per-host politeness: max concurrent requests and min seconds between requests.
HTTP_PER_HOST_CONCURRENCY=4
HTTP_PER_HOST_MIN_INTERVAL=0.0
# Must start with "Mozilla/" or some payer WAFs (Cloudflare) return 403.
HTTP_USER_AGENT=Mozilla/5.0 (compatible; CMS-9115F-ProvDirEval/0.1; +https://github.com/prov-dir-eval)

# --- Reference IG version (decided) ------------------------------------------
PLANNET_IG_VERSION=1.2.0

# ---------------------------------------------------------------------------
# Payer credentials. Endpoints whose required secrets are blank are
# automatically marked `skipped: missing-credentials` and excluded from runs.
# The 7 MVP endpoints (Humana, Capital Blue, Excellus, BCBS-KS, BCBS-MN,
# Premera, Banner) need NO credentials.
# ---------------------------------------------------------------------------

# Florida Blue (public client-id header)
BCBSFL_CLIENT_ID=

# HCSC / BCBS IL-TX-NM-OK-MT (ClientId + ClientSecret headers)
HCSC_CLIENT_ID=
HCSC_CLIENT_SECRET=

# Highmark provider directory (API key header)
HIGHMARK_API_KEY=
HIGHMARK_ORG_CODE=

# BCBS Kansas (Azure APIM subscription key -> Ocp-Apim-Subscription-Key header)
BCBSKS_SUBSCRIPTION_KEY=

# OAuth2 client-credentials payers (token URL is configured per-endpoint)
AETNA_CLIENT_ID=
AETNA_CLIENT_SECRET=
ARKBCBS_CLIENT_ID=
ARKBCBS_CLIENT_SECRET=
BCBSLA_CLIENT_ID=
BCBSLA_CLIENT_SECRET=
BCBSAL_CLIENT_ID=
BCBSAL_CLIENT_SECRET=
BCBSSC_CLIENT_ID=
BCBSSC_CLIENT_SECRET=
ELEVANCE_CLIENT_ID=
ELEVANCE_CLIENT_SECRET=

# Regence / HealthSparq public token body params
REGENCE_INSURER_CODE=
REGENCE_BRAND_CODE=

# --- Portal-gated base URLs (fill once registered) ---------------------------
CAREFIRST_BASE_URL=
BCBSMA_BASE_URL=
HORIZON_BASE_URL=
BCBSND_BASE_URL=
BCBSRI_PROVDIR_PATH=
BCBST_BASE_URL=
